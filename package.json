{
  "name": "learnforge-platform",
  "version": "2.0.0",
  "description": "LearnForge Full-Stack MERN Learning Platform (MongoDB, Express, React, Node.js)",
  "scripts": {
    "server": "npm --prefix server run dev",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "seed": "node server/scripts/seed.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
