# Copy this file to .env for local development:
#   cp .env.example .env
# Render sets these as real environment variables directly in its
# dashboard for production — never commit a real .env file.

# If unset, the app falls back to a local SQLite file (learnforge.db) —
# zero setup needed for local development. Render provides this
# automatically once a PostgreSQL instance is attached to the service.
# DATABASE_URL=postgresql://user:password@localhost:5432/learnforge

# Signs session cookies and CSRF tokens. The value below is fine for
# local development only. Generate a real random value for production,
# e.g. with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
